{
  "name": "candela-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "design:generate": "node scripts/design-tokens.mjs",
    "design:check": "designmd lint ../../docs/design/DESIGN.md && node scripts/design-tokens.mjs --check",
    "prebuild": "npm run design:check",
    "test:design": "playwright test --config playwright.design.config.ts",
    "test:daily": "playwright test --config playwright.daily.config.ts"
  },
  "devDependencies": {
    "@google/design.md": "0.4.0",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/noto-serif-sc": "^5.3.0",
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "echarts": "^6.1.0",
    "get-nonce": "1.0.1",
    "lucide-react": "^1.44.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.6.0"
  }
}
