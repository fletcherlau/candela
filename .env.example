# candela 开发环境密钥模板。复制为 .env 并填入真实值；.env 已被 gitignore。

# MySQL root 密码（docker compose 启动 MySQL 与拼接容器内 DSN 时使用）
MYSQL_ROOT_PASSWORD=changeme
# MySQL 连接串（宿主机直接跑 syncer 二进制时使用；容器内由 compose 覆盖为 mysql 服务名）
MYSQL_DSN=root:changeme@tcp(127.0.0.1:3306)/candela?charset=utf8mb4&parseTime=true&loc=Local
# Tushare API token（需 >=2000 积分以访问 fund_daily / fund_adj）
TUSHARE_TOKEN=
# 触发接口鉴权密钥；留空则不鉴权（仅限本地调试）
SYNC_API_KEY=
